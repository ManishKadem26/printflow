# Copy this file to backend/.env and fill in your own values.
# Never commit or share backend/.env.

# Cloudflare R2 Credentials
R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=printflow-uploads

# Supabase Credentials (service key = server only, never put it in the frontend)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=

# Staff PINs: at least 4 characters, different from each other. Use 6+ digits.
WORKER_SECRET_PIN=
OWNER_SECRET_PIN=

# Optional: Razorpay (leave blank to accept direct UPI + UTR only).
# Use rzp_test_ keys while testing; the secret stays on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated sites allowed to call this API, e.g. https://printflow.example.com
# "*" allows any site (fine for local testing only).
ALLOWED_ORIGINS=*
